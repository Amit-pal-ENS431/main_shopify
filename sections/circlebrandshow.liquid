<div>
  <div>
    <h1>{{ section.settings.title_head }}</h1>
    <p>{{ section.settings.description }}</p>
  </div>
  <div>
    <div class="image-wrapper">
      {% if section.settings.background_image != blank %}
        <img src="{{ section.settings.background_image | img_url: 'master' }}" alt="Background Image" width="100%" height="auto">
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "brandshow",
  "tag": "section",
  "class": "",
  "settings": [
    {
      "type": "text",
      "label": "Title",
      "id": "title_head",
      "default": "Your Brand Title"
    },
    {
      "type": "text",
      "label": "Description",
      "id": "description",
      "default": "Your brand description goes here."
    },
    {
      "type": "image_picker",
      "label": "Background Image",
      "id": "background_image"
    }
  ],
  "presets": [
    {
      "name": "brandshow"
    }
  ]
}
{% endschema %}
